{
  "name": "chat-log-review",
  "version": "1.0.0",
  "description": "Review exported chatbot conversations: how many were resolved without a person, where people asked for one, where the bot fell back, and the questions behind it. Personal data masked. Reads files, no dependencies.",
  "type": "module",
  "main": "src/index.js",
  "exports": {
    ".": "./src/index.js"
  },
  "bin": {
    "chat-log-review": "bin/chat-log-review.js"
  },
  "files": [
    "bin",
    "src",
    "docs",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "test": "node --test \"test/*.test.js\"",
    "test:coverage": "node --test --experimental-test-coverage \"test/*.test.js\"",
    "check": "node tools/check.mjs",
    "example": "node tools/example.mjs"
  },
  "keywords": [
    "chatbot",
    "conversational-ai",
    "analytics",
    "containment",
    "customer-service",
    "privacy",
    "cli"
  ],
  "author": "INNERLUXES <info@innerluxes.dev>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/INNERLUXES/chat-log-review.git"
  },
  "homepage": "https://innerluxes.dev/artificial-intelligence/chatbot-development"
}
